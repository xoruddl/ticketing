# IDE가 Spotless(google-java-format)와 같은 들여쓰기로 편집하게 맞춘다.
# 최종 기준은 ./gradlew spotlessApply 결과다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
