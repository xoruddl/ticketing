#!/bin/sh
# 커밋 직전에 git이 실행하는 훅. 실패(exit 1)로 끝나면 커밋이 만들어지지 않는다.
#
# 규칙: 한 커밋에 파일 하나 정도만 담는다 (ai_docs/CONTRIBUTING.md "변경 단위").
# 2개까지 허용하는 이유: TDD 예외(테스트 1개 + 그걸 통과시키는 구현 1개)는 함께 커밋한다.
#
# 켜는 법 (클론마다 한 번): git config core.hooksPath .githooks
# 예외(기계적 변경, 떼면 빌드가 깨지는 최소 묶음): ALLOW_MULTI_FILE_COMMIT=1 git commit ...

MAX_FILES=2

# 이번 커밋에 들어갈(스테이지된) 파일 목록. 이름 변경은 한 파일로 센다.
staged=$(git diff --cached --name-only)
count=$(printf '%s\n' "$staged" | grep -c .)

if [ "$count" -le "$MAX_FILES" ]; then
  exit 0
fi

# 예외를 일부러 푼 경우. 명령에 흔적이 남아 리뷰에서 이유를 물을 수 있다.
if [ "$ALLOW_MULTI_FILE_COMMIT" = "1" ]; then
  echo "pre-commit: 파일 ${count}개 커밋을 예외로 허용한다 (ALLOW_MULTI_FILE_COMMIT=1)."
  exit 0
fi

echo "pre-commit: 커밋에 파일이 ${count}개다. 최대 ${MAX_FILES}개까지 담는다." >&2
printf '%s\n' "$staged" | sed 's/^/  - /' >&2
echo "파일 하나 정도로 나눠서 커밋한다 (ai_docs/CONTRIBUTING.md \"변경 단위\")." >&2
echo "기계적 변경·떼면 빌드가 깨지는 묶음이라면: ALLOW_MULTI_FILE_COMMIT=1 git commit ..." >&2
exit 1
